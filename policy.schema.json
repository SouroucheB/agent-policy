{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Politique de commandes agent-policy v1",
  "description": "La validation runtime ajoute les contrôles de sûreté, de doublons et de cohérence des exemples.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "entries"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    },
    "commandPrefixes": {
      "type": "array",
      "uniqueItems": true,
      "description": "Préfixes argv ajoutés une seule fois. Absence : rtk et rtk proxy, y compris dans une couche de dépôt. Liste vide : désactivation explicite.",
      "items": {
        "$ref": "#/$defs/argvPrefix"
      },
      "default": [
        [
          "rtk"
        ],
        [
          "rtk",
          "proxy"
        ]
      ]
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "riskClass",
        "justification"
      ],
      "properties": {
        "pattern": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_./:@%+,=\\-]+$"
          }
        },
        "decision": {
          "enum": [
            "allow",
            "prompt",
            "forbidden"
          ]
        },
        "riskClass": {
          "enum": [
            "destructive-program",
            "remote-publication",
            "cloud-mutation",
            "paid-provider",
            "shared-local-state",
            "arbitrary-execution",
            "read-only",
            "local-reversible"
          ]
        },
        "justification": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "residualRisk": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "match": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "notMatch": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "claudeDeny": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/claudeDeny"
          }
        },
        "engines": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "codex",
              "claude"
            ]
          },
          "default": [
            "codex",
            "claude"
          ],
          "description": "Moteurs cibles de cette entrée et de ses exemples ; absent signifie les deux."
        },
        "claudeAsk": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/claudeDeny"
          },
          "description": "Gardes Claude soumises à accord, prioritaires sur allow et inférieures à deny."
        },
        "claudePattern": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_ *\\-]+$",
          "description": "Motif Claude seul : formes exactes uniq ou exception git -C avec gardes ask obligatoires. Aucun équivalent Codex élargi."
        }
      },
      "allOf": [
        {
          "description": "Compatibilité du contrat consommateur : allow exige une classe de lecture/effet réversible ; prompt et forbidden exigent une classe de refus.",
          "oneOf": [
            {
              "properties": {
                "decision": { "const": "allow" },
                "riskClass": { "enum": ["read-only", "local-reversible"] }
              }
            },
            {
              "properties": {
                "decision": { "enum": ["prompt", "forbidden"] },
                "riskClass": {
                  "enum": [
                    "destructive-program", "remote-publication", "cloud-mutation",
                    "paid-provider", "shared-local-state", "arbitrary-execution"
                  ]
                }
              }
            }
          ]
        }
      ],
      "oneOf": [
        {
          "required": [
            "pattern",
            "match",
            "notMatch"
          ],
          "not": {
            "required": [
              "claudePattern"
            ]
          }
        },
        {
          "required": [
            "claudeDeny",
            "residualRisk"
          ],
          "properties": {
            "decision": {
              "const": "forbidden"
            }
          },
          "not": {
            "anyOf": [
              {
                "required": [
                  "pattern"
                ]
              },
              {
                "required": [
                  "match"
                ]
              },
              {
                "required": [
                  "notMatch"
                ]
              },
              {
                "required": [
                  "claudePattern"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "claudePattern",
            "engines",
            "match",
            "notMatch"
          ],
          "properties": {
            "engines": {
              "const": [
                "claude"
              ]
            }
          },
          "not": {
            "required": [
              "pattern"
            ]
          }
        }
      ]
    },
    "claudeDeny": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pattern",
        "match",
        "notMatch"
      ],
      "properties": {
        "pattern": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_./:@%+,= *<>|()\"'~$`\\\\\\-]+$"
        },
        "match": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "notMatch": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    "argvPrefix": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_./:@%+,=\\-]+$"
      }
    }
  }
}
